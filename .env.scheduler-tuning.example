# Scheduler tuning example for crawlbot_portable_scheduler_lab
# Base operational values are copied from:
# /home/farm4bot/work/crawlbot_OK_portable_20260321/.env
# Secret fields are intentionally left blank so this file is safe to copy/share.

# Normal/user mode layout
DATA_FOLDER=./data
CHROME_USER_DATA_DIR=./chrome_user_data
LOGS_FOLDER=./logs

# Telegram Bot Configuration
# Fill real secrets only in your local .env, not in this example file.
TELEGRAM_TOKEN=
ADMIN_CHAT_ID=2079315704
ALERT_CHAT_ID=-1002246274184

# Zalo Configuration
DEFAULT_GROUP_NAME=RET 2 ROOM
GROUP_NAMES=RET 2 ROOM LỊCH, HEY KLUB
GROUP_SWITCH_MIN_SEC=5
GROUP_SWITCH_MAX_SEC=15
LOGIN_TIMEOUT=300
CHROME_DEBUG_PORT=9222

# Crawler Settings
MAX_MESSAGES=200
MESSAGE_CRAWL_INTERVAL=1
KEYWORD_UPDATE_INTERVAL=60
AUTOSAVE_INTERVAL=30

# Multi-room anti-miss tuning
MULTI_ROOM_STABLE_WAIT_2ROOM=1.5
MULTI_ROOM_STABLE_WAIT_3ROOM=1.0
SCHED_MAX_CONSECUTIVE_VISITS=2
SCHED_STARVATION_SEC_2ROOM=6
SCHED_STARVATION_SEC_3ROOM=8
SCHED_HOT_SLEEP_SEC=1
SCHED_PRESSURE_SLEEP_SEC=2
SCHED_NORMAL_SLEEP_MIN_SEC_2ROOM=2
SCHED_NORMAL_SLEEP_MAX_SEC_2ROOM=3
SCHED_NORMAL_SLEEP_MIN_SEC_3ROOM=2
SCHED_NORMAL_SLEEP_MAX_SEC_3ROOM=4

# System Monitoring
SYSTEM_CHECK_INTERVAL=60
CPU_THRESHOLD=80
MEMORY_THRESHOLD=80
DISK_THRESHOLD=90

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Run mode
HEADLESS=false
# CHROME_BINARY=/usr/bin/google-chrome-stable
