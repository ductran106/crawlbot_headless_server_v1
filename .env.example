# Normal/user mode layout (đường dẫn tuyệt đối hoặc tương đối)
DATA_FOLDER=./data
CHROME_USER_DATA_DIR=./chrome_user_data
LOGS_FOLDER=./logs

# Telegram Bot Configuration (để trống nếu chưa cấu hình thật)
TELEGRAM_TOKEN=
ADMIN_CHAT_ID=
ALERT_CHAT_ID=

# Zalo Configuration
DEFAULT_GROUP_NAME=RETURN ROOM LỊCH
LOGIN_TIMEOUT=300
CHROME_DEBUG_PORT=9222

# Crawler Settings
MAX_MESSAGES=200
MESSAGE_CRAWL_INTERVAL=1
KEYWORD_UPDATE_INTERVAL=60
AUTOSAVE_INTERVAL=30

# System Monitoring
SYSTEM_CHECK_INTERVAL=60
CPU_THRESHOLD=80
MEMORY_THRESHOLD=80
DISK_THRESHOLD=90

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Normal/user mode mặc định nên mở Chrome thật để người dùng quan sát/đăng nhập
HEADLESS=false

# Optional: Nếu Chrome không ở PATH mặc định
# CHROME_BINARY=/usr/bin/google-chrome-stable
