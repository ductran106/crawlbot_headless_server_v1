# Headless/server mode layout
DATA_FOLDER=./data
CHROME_USER_DATA_DIR=./chrome_user_data
LOGS_FOLDER=./logs

# Telegram Bot Configuration
TELEGRAM_TOKEN=
ADMIN_CHAT_ID=
ALERT_CHAT_ID=

# Zalo / browser
DEFAULT_GROUP_NAME=RETURN ROOM LỊCH
GROUP_NAMES=RET 2 ROOM LỊCH,HEY KLUB
LOGIN_TIMEOUT=300
CHROME_DEBUG_PORT=9222
HEADLESS=true
# CHROME_BINARY=/usr/bin/google-chrome-stable
CHROME_WINDOW_WIDTH=1920
CHROME_WINDOW_HEIGHT=1080

# Crawler settings
MAX_MESSAGES=200
MESSAGE_CRAWL_INTERVAL=1
KEYWORD_UPDATE_INTERVAL=60
AUTOSAVE_INTERVAL=30

# Scheduler tuning
MULTI_ROOM_STABLE_WAIT_2ROOM=1.5
MULTI_ROOM_STABLE_WAIT_3ROOM=1.0
SCHED_MAX_CONSECUTIVE_VISITS=2
SCHED_STARVATION_SEC_2ROOM=6
SCHED_STARVATION_SEC_3ROOM=8
SCHED_HOT_SLEEP_SEC=1
SCHED_PRESSURE_SLEEP_SEC=2
SCHED_NORMAL_SLEEP_MIN_SEC_2ROOM=2
SCHED_NORMAL_SLEEP_MAX_SEC_2ROOM=3
SCHED_NORMAL_SLEEP_MIN_SEC_3ROOM=2
SCHED_NORMAL_SLEEP_MAX_SEC_3ROOM=4

# Driver timeouts
DRIVER_PAGE_LOAD_TIMEOUT=300
DRIVER_SCRIPT_TIMEOUT=300
DRIVER_PROACTIVE_RECYCLE_MINUTES=180
DRIVER_PROACTIVE_RECYCLE_ROOM_CYCLES=900

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
